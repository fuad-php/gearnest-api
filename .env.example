# ---------------------------------------------------------------------------
# GearNest API — copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/gear_nest

# Auth bridge (must match the client)
BETTER_AUTH_URL=http://localhost:3000

# CORS allow-list — comma-separated origins
CLIENT_URL=http://localhost:3000

# Stripe (optional — checkout runs in demo mode when the key is empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# imgbb image uploads (optional — owners can paste direct image URLs instead)
IMGBB_API_KEY=

# Email notifications (optional — messages are logged to the console when empty)
# Works with any SMTP provider: Resend, SendGrid, Mailgun, Gmail app passwords…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GearNest <no-reply@gearnest.com>
